{
  "name": "Exam-Timetable",
  "private": true,
  "version": "1.0.0",
  "main": "electron-main.js",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --outdir=. --external:vite --external:express --external:dotenv --external:@google/genai",
    "start": "node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "electron": "electron .",
    "electron:dev": "vite build && electron .",
    "pack": "vite build && electron-builder --dir --config electron-builder.yml",
    "dist": "vite build && electron-builder --win --x64 --config electron-builder.yml --publish never",
    "build:win": "vite build && electron-builder --win --x64 --config electron-builder.yml --publish never",
    "publish:win": "vite build && electron-builder --win --x64 --config electron-builder.yml --publish always"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "3.11.174",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@firebase/util": true,
    "@google/genai": true,
    "electron": true,
    "electron-winstaller": true,
    "esbuild": true,
    "protobufjs": true
  }
}
