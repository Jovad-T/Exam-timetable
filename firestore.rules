rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 100;
    }

    function isValidSchool(data) {
      return data.keys().hasAll(['name', 'slug', 'updatedAt'])
        && data.keys().hasOnly(['name', 'slug', 'logoUrl', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.slug is string && data.slug.size() > 0 && data.slug.size() <= 100
        && data.updatedAt is string
        && (!('logoUrl' in data) || data.logoUrl is string);
    }

    function isValidSchedule(data) {
      return data.keys().hasAll(['schoolSlug', 'scheduleJson', 'updatedAt'])
        && data.keys().hasOnly(['schoolSlug', 'schoolName', 'scheduleJson', 'updatedAt', 'alertSettings', 'classTotals', 'maxClasses'])
        && data.schoolSlug is string && data.schoolSlug.size() > 0 && data.schoolSlug.size() <= 100
        && data.scheduleJson is string && data.scheduleJson.size() > 0
        && data.updatedAt is string
        && (!('schoolName' in data) || data.schoolName is string)
        && (!('alertSettings' in data) || data.alertSettings is map)
        && (!('classTotals' in data) || data.classTotals is map)
        && (!('maxClasses' in data) || (data.maxClasses is number || data.maxClasses is int));
    }

    // Connection validation doc
    match /test/connection {
      allow read: if true;
    }

    match /schools/{schoolSlug} {
      allow get: if isValidId(schoolSlug);
      allow list: if true;
      allow create, update: if isValidId(schoolSlug) && isValidSchool(request.resource.data);
      allow delete: if false;

      match /schedules/{scheduleId} {
        allow get: if isValidId(schoolSlug) && isValidId(scheduleId);
        allow list: if isValidId(schoolSlug);
        allow create, update: if isValidId(schoolSlug) && isValidId(scheduleId) && isValidSchedule(request.resource.data);
        allow delete: if false;
      }
    }
  }
}
